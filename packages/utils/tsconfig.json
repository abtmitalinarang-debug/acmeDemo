{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictNullChecks": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolvePackageJsonImports": true,
    "types": ["node"]
  },
  "include": ["src", "*.ts", "*.tsx"],
  "exclude": ["node_modules", "dist"]
}